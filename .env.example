# === Application ===
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/freelance_radar.db
# For PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/freelance_radar
TIMEZONE=Europe/Moscow

# === Owner / control bot (aiogram) ===
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# === Telethon user session (optional: reading Telegram channels) ===
# Create at https://my.telegram.org — required only for Telegram source adapter
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telethon.session
# Comma-separated public channel usernames or invite links you already joined
TELEGRAM_SOURCE_CHANNELS=

# === LLM (OpenAI-compatible API) ===
LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Use mock LLM for offline/dev without API key
LLM_USE_MOCK=false

# === Pipeline / scheduler ===
COLLECT_INTERVAL_SECONDS=300
OUTREACH_INTERVAL_SECONDS=60
PIPELINE_BATCH_SIZE=50

# === Outreach ===
OUTREACH_ENABLED=false
OUTREACH_MIN_INTERVAL_SECONDS=30
OUTREACH_MAX_PER_HOUR=10
OUTREACH_MAX_PER_DAY=40
OUTREACH_DRY_RUN=true

# === Sources toggles ===
SOURCE_FIXTURE_ENABLED=true
SOURCE_RSS_ENABLED=true
SOURCE_TELEGRAM_ENABLED=false
SOURCE_KWORK_ENABLED=false
SOURCE_FLRU_ENABLED=false

# Comma-separated RSS feed URLs (public feeds only)
RSS_FEED_URLS=

# Path to fixture JSON for demo/offline collection
FIXTURE_ORDERS_PATH=./data/fixture_orders.json
